<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeltaStudio.App.Views.MonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,Auto,*" Margin="8">
        <TextBlock Text="Online Monitor" FontWeight="Bold" Margin="0,0,0,8" />
        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="Devices to watch (comma separated)" FontSize="11" Opacity="0.7" />
            <TextBox Text="{Binding MonitorDevicesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Start" Style="{StaticResource ToolButton}" Command="{Binding StartMonitorCommand}" />
                <Button Content="Stop" Style="{StaticResource ToolButton}" Command="{Binding StopMonitorCommand}" />
                <Border Background="{ThemeResource SystemFillColorCautionBrush}" CornerRadius="4" Padding="8,4"
                        Visibility="{Binding IsMockSession, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="MOCK session — emulated values" FontSize="11" />
                </Border>
            </StackPanel>
        </StackPanel>
        <ListView Grid.Row="2" ItemsSource="{Binding MonitorRows}" FontFamily="Consolas,Menlo,monospace" Margin="0,10,0,0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,*" Margin="0,2">
                        <TextBlock Text="{Binding Device}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
