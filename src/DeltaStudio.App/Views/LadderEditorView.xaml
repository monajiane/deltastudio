<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeltaStudio.App.Views.LadderEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DeltaStudio.App.Views">

    <!-- Ladder logic reads left-to-right in every culture: this surface pins LTR. -->
    <UserControl.FlowDirection>LeftToRight</UserControl.FlowDirection>
    <UserControl.Resources>
        <DataTemplate x:Key="ContactTemplate">
            <Border Style="{StaticResource DeviceChip}"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    ToolTipService.ToolTip="{Binding Text}">
                <StackPanel>
                    <TextBlock Text="{Binding Art}" FontFamily="Consolas,Menlo,monospace" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Device}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Polarity}" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CoilTemplate">
            <Border Style="{StaticResource DeviceChip}"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    ToolTipService.ToolTip="{Binding Text}">
                <StackPanel>
                    <TextBlock Text="{Binding Art}" FontFamily="Consolas,Menlo,monospace" FontSize="13"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Device}" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Action}" FontSize="10"
                               Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BlockTemplate">
            <Border Style="{StaticResource DeviceChip}" MinWidth="120"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    ToolTipService.ToolTip="{Binding Text}">
                <StackPanel>
                    <TextBlock Text="{Binding Mnemonic}" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Operands}" FontSize="11" Opacity="0.8" HorizontalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="160" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ParallelTemplate">
            <Border BorderThickness="1" Padding="4" Margin="8,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" CornerRadius="4">
                <ItemsControl ItemsSource="{Binding Branches}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding}"
                                          ItemTemplateSelector="{StaticResource LadderSelector}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </DataTemplate>

        <views:LadderElementTemplateSelector x:Key="LadderSelector"
            ContactTemplate="{StaticResource ContactTemplate}"
            CoilTemplate="{StaticResource CoilTemplate}"
            BlockTemplate="{StaticResource BlockTemplate}"
            ParallelTemplate="{StaticResource ParallelTemplate}" />
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto">
        <ListView Grid.Row="0"
                  ItemsSource="{Binding Rungs}"
                  SelectedItem="{Binding SelectedRung, Mode=TwoWay}"
                  SelectionMode="Single"
                  IsItemClickEnabled="False"
                  ScrollViewer.VerticalScrollMode="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource RungPanelStyle}">
                        <StackPanel>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="{Binding Number}" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Comment, Mode=OneWay}" IsReadOnly="True"
                                         BorderThickness="0" Background="Transparent" Margin="12,0"
                                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <FontIcon Grid.Column="2" Glyph="&#xE713;" FontSize="14" Opacity="0.5" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                <Rectangle Width="6" StrokeThickness="1.5" RadiusX="2" RadiusY="2"
                                           Stroke="{ThemeResource SystemAccentColor}" Margin="0,14" />
                                <ItemsControl ItemsSource="{Binding Elements}"
                                              ItemTemplateSelector="{StaticResource LadderSelector}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Rectangle Width="6" StrokeThickness="1.5" RadiusX="2" RadiusY="2"
                                           Stroke="{ThemeResource SystemAccentColor}" Margin="0,14" />
                            </StackPanel>
                            <TextBlock Text="{Binding IlPreview}" FontFamily="Consolas,Menlo,monospace" FontSize="11"
                                       Opacity="0.65" Margin="4,2,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- inline element toolbar (PARTIAL: series insertion only; parallel wiring via MCP/AI tools) -->
        <Border Grid.Row="1" Padding="8,6" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Device:" VerticalAlignment="Center" />
                <TextBox Width="96" Text="{Binding DeviceDialogText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="+ NO"  Style="{StaticResource ToolButton}" Command="{Binding AddContactCommand}" CommandParameter="NO" />
                <Button Content="+ NC"  Style="{StaticResource ToolButton}" Command="{Binding AddContactCommand}" CommandParameter="NC" />
                <Button Content="+ UP"  Style="{StaticResource ToolButton}" Command="{Binding AddContactCommand}" CommandParameter="UP" />
                <Button Content="+ OUT" Style="{StaticResource ToolButton}" Command="{Binding AddCoilCommand}" CommandParameter="OUT" />
                <Button Content="+ SET" Style="{StaticResource ToolButton}" Command="{Binding AddCoilCommand}" CommandParameter="SET" />
                <Button Content="+ RST" Style="{StaticResource ToolButton}" Command="{Binding AddCoilCommand}" CommandParameter="RST" />
                <Button Content="Add Rung" Style="{StaticResource ToolButton}" Command="{Binding AddRungCommand}" />
                <Button Content="Delete Rung" Style="{StaticResource ToolButton}" Command="{Binding DeleteRungCommand}" />
                <Button Content="↑" Command="{Binding MoveRungCommand}" CommandParameter="up" ToolTipService.ToolTip="Move selected rung up" />
                <Button Content="↓" Command="{Binding MoveRungCommand}" CommandParameter="down" ToolTipService.ToolTip="Move selected rung down" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
